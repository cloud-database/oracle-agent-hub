# OracleAgentHub Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to source control.

# ─── Oracle Database (Future Backend Integration) ───────────────────────────
ORACLE_DB_USER=
ORACLE_DB_PASSWORD=
ORACLE_DB_HOST=localhost
ORACLE_DB_PORT=1521
ORACLE_DB_SERVICE=freepdb1

# ─── Application ────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=OracleAgentHub

# ─── Email / Contact Form ───────────────────────────────────────────────────
CONTACT_FORM_EMAIL=
RESEND_API_KEY=

# ─── Analytics (Optional) ───────────────────────────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=
